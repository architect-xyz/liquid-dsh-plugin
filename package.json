{
  "name": "dsh-liquid-inference",
  "version": "0.1.0",
  "description": "Liquid Inference for DeepSeek Harness: a `liquid` model route plus read-only market tools",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "liquid-inference"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
